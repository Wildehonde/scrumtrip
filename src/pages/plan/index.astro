---
import Base from '../../layouts/Base.astro';
import { matches, teams, stageLabel, pools, teamKnockouts } from '../../data/tournament.js';
import { byTeam, visas } from '../../data/visa.js';
import { T } from '../../data/tickets.js';
import { ORIGINS, CITY_IATA, IATA_NAME, live, checked, MARKER } from '../../data/flights.js';
import { identity } from '../../data/identity.js';
const ID = Object.fromEntries(Object.entries(identity).map(([t,x])=>[t,{n:x.nick,a:x.accent}]));
const M = matches.map(m=>({st:m.stage,n:m.n,d:m.date,ko:m.ko,t:m.title,h:m.home,a:m.away,s:stageLabel(m.stage),v:m.venueName,c:m.cityName,la:m.lat,lo:m.lon,ck:m.city,u:m.utc}));
const KP = Object.fromEntries(teams.map(t=>[t.name, teamKnockouts(t.name).map(o=>({pos:o.pos,label:o.label,it:o.items.map(i=>({n:i.m.n,r:i.rule,g:i.guess}))}))]));
const FL = {o:ORIGINS, ci:CITY_IATA, nm:IATA_NAME, r:live.routes, ck:checked, mk:MARKER};
const TP = Object.fromEntries(teams.map(t=>[t.name,t.pool]));
const V = Object.fromEntries(Object.entries(byTeam).map(([t,x])=>[t, x.options.length? x.options.map(o=>visas[o].code).join(' or ') : (x.note||'')]));
---
<Base title="Trip planner: plan & share your RWC 2027 trip" description="Build your Rugby World Cup 2027 trip itinerary and share it with your mates on WhatsApp.">
<div id="builder">
<h1>Plan your trip</h1><p class="muted">Pick your team and matches, then share the plan with your mates. Everything stays in the link; nothing is saved on a server.</p>
<form id="pf" class="pform">
<label>Trip name<input name="name" placeholder="Boks Tour 2027" maxlength="60"/></label>
<label>Team<select name="team" required><option value="">Choose…</option>{teams.map(t=><option>{t.name}</option>)}</select></label>
<label>Home city<input name="home" placeholder="Johannesburg" maxlength="40"/></label>
<label>Number of mates<input name="mates" type="number" min="1" max="99" value="4"/></label>
<label>Arrive<input name="arrive" type="date" min="2027-09-01" max="2027-11-30" value="2027-10-01"/></label>
<label>Depart<input name="depart" type="date" min="2027-09-01" max="2027-11-30" value="2027-10-19"/></label>
<fieldset><legend>Matches <button type="button" class="btn small ghost" id="mine">Select my team's</button></legend><div class="muted" id="kohint" hidden></div><div id="mlist" class="mlist"></div></fieldset>
<button class="btn" type="submit">Build my plan</button>
</form></div>
<div id="view" hidden>
<p class="kicker" id="vk"></p><h1 id="vt"></h1><p id="vsum"></p>
<div class="teamband"></div><div class="count" id="cd"></div>
<div class="share" id="sharebar">
<a class="btn" id="wa" target="_blank" rel="noopener">Share on WhatsApp</a>
<button class="btn ghost" id="copy">Copy link</button>
<button class="btn ghost" id="native" hidden>Share…</button>
<button class="btn ghost" id="edit">Edit plan</button></div>
<div class="share" id="sharedbar" hidden><button class="btn" id="imin">I'm in! 🙌</button><a class="btn ghost" href="/plan/">Make your own plan</a></div>
<p id="toast" class="note" hidden></p>
<h2>Itinerary</h2><ol id="itin" class="itin"></ol>
<h2>Matches</h2><ul id="vm" class="matches"></ul>
<h2>Tickets</h2><p class="note">Buy only through official channels. Tickets from unofficial sellers are invalid and entry will be denied. <a href="/tickets/">How to buy safely →</a></p><ul id="vtix" class="tixlist"></ul>
<h2>Visa</h2><p id="vv"></p><p class="muted">Not legal advice. Check immi.homeaffairs.gov.au. <a href="/visa/">Visa checklist →</a></p>
<h2>Book</h2><div id="vb" class="deals"></div>
</div>
<script is:inline src="/js/plancodec.js"></script>
<script is:inline define:vars={{M,V,T,ID,KP,TP,FL}}>
const $=s=>document.querySelector(s), f=$('#pf');
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const day=d=>new Date(d+'T12:00:00Z').toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short',timeZone:'UTC'});
const SG=[['Pool','Pool matches'],['R16','Knockouts: Round of 16'],['QF','Knockouts: Quarter-finals'],['SF','Knockouts: Semi-finals'],['Bronze','Knockouts: Bronze final'],['Final','Knockouts: Final']];
$('#mlist').innerHTML=SG.map(([k,h])=>{const ms=M.filter(m=>(m.st.length===1?'Pool':m.st)===k); return `<h4 class="stagehead">${h}</h4>`+ms.map(m=>`<label class="mi" data-teams="${esc((m.h||'')+'|'+(m.a||''))}"><input type="checkbox" value="${m.n}"/> <b>${day(m.d)}</b> ${esc(m.t)} <span class="muted">· ${esc(m.c)}</span> <span class="kob"></span></label>`).join('');}).join('');
function nickOf(t){return (ID[t]&&ID[t].n)||t;}
const badgeTxt=(t,o,i)=>`${o.pos==1?'Likely if '+nickOf(t)+' '+o.label.replace(' (likely)','').replace(/^Top/,'top'):'If '+o.label}: ${i.r}${i.g?' · likely '+i.g+' (guess)':' · bracket rule only'}`;
function badges(){const t=f.team.value, ops=KP[t]; $('#kohint').hidden=!ops;
  if(ops){const cur=(f.querySelector('input[name=fin]:checked')||{}).value||'1'; $('#kohint').innerHTML='Knockouts: '+ops.map(o=>`<label><input type="radio" name="fin" value="${o.pos}"${o.pos==cur?' checked':''}/> ${esc(o.label)}</label>`).join(' ')+' <i>Opponent names are guesses from pool seeding.</i>'; f.querySelectorAll('input[name=fin]').forEach(r=>r.onchange=()=>$('#mine').click());}
  document.querySelectorAll('.mi').forEach(l=>{const n=+l.querySelector('input').value; const hits=ops?ops.flatMap(o=>o.it.filter(i=>i.n===n).map(i=>({o,i}))):[];
    l.querySelector('.kob').innerHTML=hits.map(({o,i})=>`<span class="tag ko${o.pos==1?' likely':''}">${esc(badgeTxt(t,o,i))}</span>`).join(' ');});}
function koFor(t){const fin=+((f.querySelector('input[name=fin]:checked')||{}).value||0); const o=KP[t]&&KP[t].find(x=>x.pos===fin); return o?o.it.map(i=>i.n):[];}
f.team.onchange=()=>{badges();$('#mine').click();};
function render(p, shared){
  $('#builder').hidden=true; $('#view').hidden=false; $('#sharebar').hidden=shared; $('#sharedbar').hidden=!shared;
  const ms=M.filter(m=>p.matches.includes(m.n)).sort((a,b)=>a.u.localeCompare(b.u));
  const nk=(ID[p.team]&&ID[p.team].n)||p.team; const title=p.name||`Our ${nk} tour`; document.documentElement.style.setProperty('--acc',(ID[p.team]&&ID[p.team].a)||'#0b5d3b');
  document.title=`${title} | ScrumTrip`;
  $('#vk').textContent=`${nk!==p.team?nk+' ('+p.team+')':p.team} · ${p.mates||1} ${p.mates==1?'person':'mates'}${p.home?' · from '+p.home:''}`;
  $('#vt').textContent=title;
  const cities=[...new Set(ms.map(m=>m.c))];
  $('#vsum').textContent=`${day(p.arrive)} → ${day(p.depart)} · ${ms.length} match${ms.length==1?'':'es'} · ${cities.join(' → ')||'no matches picked yet'}`;
  const tick=()=>{const t=new Date(p.arrive+'T00:00:00')-Date.now(), d=Math.max(0,Math.ceil(t/864e5)); $('#cd').innerHTML=`<b>${d}</b> days to go`;}; tick();
  // itinerary by day
  const out=[]; let cur=null; const s=new Date(p.arrive+'T12:00:00Z'), e=new Date(p.depart+'T12:00:00Z');
  for(let d=new Date(s); d<=e && out.length<120; d.setUTCDate(d.getUTCDate()+1)){
    const iso=d.toISOString().slice(0,10); const todays=ms.filter(m=>m.d===iso);
    const next=ms.find(m=>m.d>=iso); let txt;
    if(iso===p.arrive) txt=`Arrive in Australia${p.home?' from '+esc(p.home):''}${next?', head to <b>'+esc(next.c)+'</b>':''}`;
    if(todays.length){ txt=(txt?txt+'. ':'')+todays.map(m=>`🏉 <b>${esc(m.t)}</b>, ${esc(m.v)}, ${esc(m.c)} (${m.ko} local)`).join('<br>'); cur=todays.at(-1).c; }
    else if(iso===p.depart) txt=(txt?txt+'. ':'')+'Fly home ✈';
    else if(!txt){ if(next && cur && next.c!==cur && next.d!==iso && ms.findIndex(m=>m.d>iso)===ms.indexOf(next)){ const prev=new Date(next.d+'T12:00:00Z'); prev.setUTCDate(prev.getUTCDate()-1); txt = prev.toISOString().slice(0,10)===iso?`Travel ${esc(cur)} → <b>${esc(next.c)}</b>`:`Free day in ${esc(cur)}`; } else txt=`Free day${cur?' in '+esc(cur):''}`; }
    out.push(`<li><span class="d">${day(iso)}</span><span>${txt}</span></li>`);
  }
  $('#itin').innerHTML=out.join('');
  $('#vm').innerHTML=ms.map((m,ix)=>{const g=SG.find(([k])=>k===(m.st.length===1?'Pool':m.st))[1]; const prev=ix?SG.find(([k])=>k===(ms[ix-1].st.length===1?'Pool':ms[ix-1].st))[1]:null; return (g!==prev?`<li class="stagehead"><h4>${g}</h4></li>`:'')+`<li class="match"><div class="when"><b>${day(m.d)}</b><span>${m.ko} local</span></div><div class="what"><span class="tag">${esc(m.s)}</span>${(()=>{const ops=KP[p.team]||[];return ops.flatMap(o=>o.it.filter(i=>i.n===m.n).map(i=>` <span class="tag ko${o.pos==1?' likely':''}">${esc(badgeTxt(p.team,o,i))}</span>`)).join('');})()}<h3>${esc(m.t)}</h3><p>${esc(m.v)}, <a href="/cities/${m.ck}/">${esc(m.c)}</a> · <a target="_blank" rel="noopener" href="https://www.openstreetmap.org/?mlat=${m.la}&mlon=${m.lo}#map=16/${m.la}/${m.lo}">📍 Stadium map</a> · <a href="/cities/${m.ck}/">🗺 City & Australia maps</a></p></div><a class="btn small" href="/ics/match-${m.n}.ics">+ Calendar</a></li>`;}).join('')||'<li class="muted">No matches selected.</li>';
  $('#vtix').innerHTML=ms.map(m=>`<li><span><b>${day(m.d)}</b> ${esc(m.t)} · ${esc(m.c)}</span><span class="acts"><a class="btn small tix" target="_blank" rel="noopener" href="${T.official}">Official tickets ↗</a><a class="btn small ghost" target="_blank" rel="noopener" href="${T.hospitality}">Hospitality ↗</a></span></li>`).join('')||'<li class="muted">No matches selected.</li>';
  $('#vv').innerHTML=`${esc(p.team)} passport holders: <b>${esc(V[p.team]||'check official site')}</b>`;
  $('#vb').innerHTML=cities.map(c=>`<a class="deal" rel="sponsored nofollow" href="#affiliate-hotels-${encodeURIComponent(c)}"><b>🏨 Hotels in ${esc(c)}</b><span>for ${p.mates||1} (affiliate placeholder)</span></a>`).join('')+(()=>{const o=(FL.o[p.team]||[])[0]; const first=ms[0]; const d=first?FL.ci[first.ck]:'SYD'; if(!o) return ''; const dt=p.arrive; const fr=FL.r[o+'-'+d];
  const href=`https://www.aviasales.com/search/${o}${dt.slice(8,10)}${dt.slice(5,7)}${d}1?marker=${FL.mk}`;
  return `<a class="deal" rel="sponsored nofollow noopener" target="_blank" href="${href}"><b>✈ Flights ${esc(FL.nm[o])} → ${esc(FL.nm[d])}, ${day(dt)}</b><span>${fr?'from $'+fr.price+(fr.indicative?' (indicative)':'')+' · ':''}Prices from Aviasales${FL.ck?', checked '+esc(FL.ck):''}</span></a>`;})();
}
async function share(p){
  const code=await encodePlan(p); const url=`${location.origin}/plan/#${code}`;
  history.replaceState(null,'',`#edit=${code}`);
  const nk=(ID[p.team]&&ID[p.team].n)||p.team; const msg=`🏉 ${p.name||'Our '+nk+' tour'}: following the ${nk} at Rugby World Cup 2027. Who's in? ${url}\n🎟 Reminder: buy match tickets only from official RWC 2027 ticketing (tickets.rugbyworldcup.com), not resellers.`;
  $('#wa').href='https://wa.me/?text='+encodeURIComponent(msg);
  const toast=t=>{$('#toast').textContent=t;$('#toast').hidden=false;setTimeout(()=>$('#toast').hidden=true,3000);};
  $('#copy').onclick=async()=>{try{await navigator.clipboard.writeText(url);toast('Link copied!');}catch{prompt('Copy this link',url);}};
  if(navigator.share){ $('#native').hidden=false; $('#native').onclick=()=>navigator.share({title:p.name||'ScrumTrip plan',text:msg,url}).catch(()=>{}); }
  $('#edit').onclick=()=>{$('#view').hidden=true;$('#builder').hidden=false;};
  window.__shareUrl=url;
}
f.onsubmit=async e=>{e.preventDefault(); const p={team:f.team.value,matches:[...f.querySelectorAll('#mlist input:checked')].map(i=>+i.value),arrive:f.arrive.value,depart:f.depart.value,home:f.home.value.trim(),name:f.name.value.trim(),mates:+f.mates.value||1};
  if(p.depart<p.arrive){alert('Departure must be after arrival');return;} render(p,false); await share(p); scrollTo(0,0); };
(async()=>{const h=location.hash.slice(1); if(!h) return; const isEdit=h.startsWith('edit='); try{const p=await decodePlan(isEdit?h.slice(5):h); window.__plan=p;
  if(isEdit){ f.team.value=p.team; ['name','home','mates','arrive','depart'].forEach(k=>f[k].value=p[k]??''); badges(); document.querySelectorAll('#mlist input').forEach(i=>i.checked=p.matches.includes(+i.value)); render(p,false); share(p); }
  else { render(p,true); $('#imin').onclick=async()=>{const t=`I'm in for ${p.name||'the '+((ID[p.team]&&ID[p.team].n)||p.team)+' tour'}! 🏉🇦🇺`; try{await navigator.clipboard.writeText(t);}catch{} $('#toast').textContent='Reply copied. Paste it in your group chat!'; $('#toast').hidden=false;}; }
 }catch(err){ $('#toast').textContent='That plan link looks broken. Make a new one below.'; $('#toast').hidden=false; }})();
</script>
</Base>

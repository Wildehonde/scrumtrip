---
import Base from '../../layouts/Base.astro';
import MatchList from '../../components/MatchList.astro';
import Deals from '../../components/Deals.astro';
import FanIntro from '../../components/FanIntro.astro';
import { identity, display } from '../../data/identity.js';
import VisaBox from '../../components/VisaBox.astro';
import { eventSchema } from '../../lib/schema.js';
import { teams, matches, pools, cities, slug, teamKnockouts, KO_STAGES } from '../../data/tournament.js';
export function getStaticPaths(){ return teams.map(t=>({params:{slug:t.slug}, props:{team:t}})); }
const { team } = Astro.props;
const mine = matches.filter(m=>m.home===team.name||m.away===team.name);
const ko = matches.filter(m=>m.stage==='R16' && (m.title.includes(`1st Pool ${team.pool}`)||m.title.includes(`2nd Pool ${team.pool}`)));
const opts=teamKnockouts(team.name);
const short=m=>`${m.title.split(':')[0]} · ${m.date.slice(8)} ${m.date.slice(5,7)==='10'?'Oct':'Nov'} · ${m.venueName}, ${m.cityName}`;
const cityKeys=[...new Set(mine.map(m=>m.city))];
const nick=display(team.name); const acc=identity[team.name].accent;
---
<Base schema={eventSchema(mine)} title={`${nick === team.name ? team.name : nick + " ("+team.name+")"} Rugby World Cup 2027 schedule & travel`} description={`${team.name}'s RWC 2027 pool matches, host cities and trip planning.`}>
<div class="teamband" style={`--acc:${acc}`}></div>
<p class="kicker" style={`color:${acc==="#000000"?"#111":acc}`}>{nick!==team.name?team.name+" · ":""}Pool {team.pool} · {pools[team.pool].filter(t=>t!==team.name).join(', ')}</p>
<h1>{nick}: your 2027 trip</h1>
<FanIntro team={team.name} cityNames={cityKeys.map(k=>cities[k].name).join(", ")}/>
<p>{team.name} play {mine.length} pool matches in {cityKeys.map(k=>cities[k].name).join(', ')}. <a class="btn small" href={`/ics/${team.slug}.ics`}>Add all to calendar</a></p>
<div class="cta-band"><div><b>Plan your {nick} tour</b><br/><span class="muted">Itinerary, visa and a link to share with your mates.</span></div><a class="btn" href="/plan/">Plan your trip</a></div>
<h2>Pool matches</h2><MatchList list={mine}/>
<h2>Knockouts</h2>
<p class="muted">From the official World Rugby bracket. Venues and dates are fixed; opponents depend on other pools. "Likely" names are a ScrumTrip guess from pool seeding (draw bands), not a prediction. Where it's too open to call (third-placed slots), we show the bracket rule only.</p>
<p><b>Finish options</b> (same as the trip planner buttons):</p>
<ol class="finopts">{opts.map(o=><li><b>{o.label}</b>{o.pos===0?': no knockout matches':o.pos===3?': only if among the 4 best third-placed teams':''}</li>)}</ol>
{KO_STAGES.map(([st,name])=>{const rows=opts.flatMap(o=>o.items.filter(i=>i.m.stage===st).map(i=>({...i,o})));
 return rows.length?<><h3 class="stagehead">{name}</h3><ul class="korows">{rows.map(r=>(<li class={r.o.pos===1?'likely':''}>
 <span class={`tag ko${r.o.pos===1?' likely':''}`}>{r.o.pos===1?`Likely if ${nick} top Pool ${team.pool}`:`If ${r.o.label}`}</span>
 <b>{short(r.m)}</b><br/>{nick} {r.rule}{r.guess?<span class="guess"> · likely: {r.guess} <i>(guess)</i></span>:<span class="muted"> · too open to call: bracket rule only</span>}</li>))}</ul></>:null;})}
<VisaBox team={team.name}/>
<h2>Plan the trip</h2>{cityKeys.map(k=><><h3><a href={`/cities/${k}/`}>{cities[k].name}</a></h3><Deals city={cities[k].name} team={team.name} date={(()=>{const d=new Date(mine.find(m=>m.city===k).date+'T12:00:00Z');d.setUTCDate(d.getUTCDate()-2);return d.toISOString().slice(0,10);})()}/></>)}
</Base>

---
import Base from '../../layouts/Base.astro';
import { ORIGINS, DESTS, IATA_NAME, avLink, fare, checked } from '../../data/flights.js';
import { display } from '../../data/identity.js';
const rows = Object.entries(ORIGINS).flatMap(([t, os]) => os.map(o => ({ t, o })));
---
<Base title="Flight prices to Rugby World Cup 2027 host cities" description="Cheapest Aviasales fares from every RWC 2027 nation to the seven Australian host cities.">
<h1>Flight prices</h1>
<p class="note">{checked ? `Prices from Aviasales, checked ${checked}.` : 'Prices from Aviasales.'} Cheapest cached one-way fare in USD, 1 adult. <b>*</b> = indicative: airlines haven't loaded Sep–Oct 2027 fares yet, so this is the cheapest fare on the nearest available date. Prices change constantly; tap Book for today's price. Book links are affiliate links (ScrumTrip may earn a commission).</p>
<div class="fares wide"><table><thead><tr><th>From</th>{DESTS.map(d => <th>{IATA_NAME[d]}</th>)}</tr></thead><tbody>
{rows.map(r => <tr><th>{IATA_NAME[r.o]}<br/><span class="muted small">{display(r.t)}</span></th>{DESTS.map(d => { const f = fare(r.o, d); return <td><a rel="sponsored nofollow noopener" target="_blank" href={avLink(r.o, d)} title={f ? `${f.airline} · ${f.transfers} stop(s) · ${f.departure}` : 'Search on Aviasales'}>{f ? `$${f.price}${f.indicative ? '*' : ''}` : 'Search'}</a></td>; })}</tr>)}
</tbody></table></div>
<p class="muted small">Book links search departures on 28 Sep 2027 (a few days before the opening match); change the date on Aviasales.</p>
</Base>
